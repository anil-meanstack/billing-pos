import React, { useState, useEffect, useMemo, useCallback } from "react";
import { useDispatch, useSelector } from "react-redux";
import { placeOrder } from "../../../../features/cart/cartSlice";
import "./Modal.css";
import Alert from "../../../../components/Alert/Alert";

const Modal = ({ show, onClose, item }) => {

  const dispatch = useDispatch();

  const safeItem = item ?? {};
  const { orderType, tableId } = useSelector((state) => state.cart);

  const [selected, setSelected] = useState({
    variants: {},
    addons: {},
  });

  const [activeIndex, setActiveIndex] = useState(0);
  const [quantity, setQuantity] = useState(1);

  const [showAlert, setShowAlert] = useState({
    show: false,
    message: "",
    type: "danger",
  });

  const showError = useCallback((message) => {
    setShowAlert({
      show: true,
      message,
      type: "success",
    });
  }, []);

  /* ---------------- DATA ---------------- */

  const variantGroups = useMemo(
    () => (safeItem?.variants ? [...safeItem.variants] : []),
    [safeItem.variants]
  );

  const addonCategories = useMemo(
    () => safeItem?.addon_categories || [],
    [safeItem.addon_categories]
  );

  /* ---------------- RESET ---------------- */

  useEffect(() => {
    if (!show) return;

    const defaults = {};

    variantGroups.forEach((group) => {
      if (group.variants?.length) {
        const def =
          group.variants.find((v) => v.is_default) ||
          group.variants[0];

        defaults[group.group_id] = def;
      }
    });

    setSelected({ variants: defaults, addons: {} });
    setActiveIndex(0);
    setQuantity(1);
  }, [show, variantGroups]);

  /* ---------------- MAIN VARIANT ---------------- */

  const mainVariant = useMemo(() => {
    const first = variantGroups[0];
    if (!first) return null;

    return selected.variants?.[first.group_id];
  }, [selected.variants, variantGroups]);

  /* ---------------- ADDON STEPS ---------------- */

  const addonSteps = useMemo(() => {
    if (!safeItem.has_addons) return [];

    if (!safeItem.has_variants) {
      return addonCategories.map((cat) => ({
        ...cat,
        type: "addon",
      }));
    }

    if (!mainVariant) return [];

    const normalize = (str) =>
      str?.toLowerCase().replace(/\s+/g, "").trim();

    const match = addonCategories.find(
      (c) => normalize(c.name) === normalize(mainVariant.name)
    );

    return match ? [{ ...match, type: "addon" }] : [];
  }, [mainVariant, addonCategories, safeItem]);

  /* ---------------- STEPS ---------------- */

  const steps = useMemo(() => {
    if (!safeItem.has_variants) return addonSteps;

    return [
      ...variantGroups.map((g) => ({
        ...g,
        type: "variant",
      })),
      ...addonSteps,
    ];
  }, [variantGroups, addonSteps, safeItem.has_variants]);

  /* ---------------- SAFE DERIVED VALUES ---------------- */

  const safeIndex = Math.min(
    Math.max(activeIndex, 0),
    Math.max(steps.length - 1, 0)
  );

  const activeStep = steps[safeIndex];
  const nextStep = steps[safeIndex + 1] || null;

  const maxSelections = activeStep?.max_selections || 1;

  const currentCount = useMemo(() => {
    if (!activeStep) return 0;

    if (activeStep.type === "addon") {
      return (selected.addons?.[activeStep.id] || []).length;
    }

    if (activeStep.type === "variant") {
      return selected.variants?.[activeStep.group_id] ? 1 : 0;
    }

    return 0;
  }, [activeStep, selected]);

  /* ---------------- IMPORTANT SAFE GUARD (AFTER HOOKS) ---------------- */

  if (!show || !safeItem?.id || !steps.length || !activeStep) return null;

  /* ---------------- SELECT HANDLER ---------------- */

  const handleSelect = (step, option) => {
    if (step.type === "variant") {
      setSelected((prev) => ({
        ...prev,
        variants: {
          ...prev.variants,
          [step.group_id]: option,
        },
        addons: {},
      }));

      setTimeout(() => {
        setActiveIndex((p) => (p < steps.length - 1 ? p + 1 : p));
      }, 120);
    }

    if (step.type === "addon") {
      const current = selected.addons[step.id] || [];
      const max = step.max_selections;
      const min = step.min_selections || 0;

      let updated;

      if (current.includes(Number(option.id))) {
        updated = current.filter((id) => id !== Number(option.id));
      } else {
        if (max && current.length >= max) {
          showError(`You can select only ${max} items`);
          return;
        }
        updated = [...current, Number(option.id)];
      }

      setSelected((prev) => ({
        ...prev,
        addons: {
          ...prev.addons,
          [step.id]: updated,
        },
      }));

      const shouldMove =
        (max && updated.length >= max) ||
        (!max && updated.length >= min && min > 0);

      if (shouldMove) {
        setTimeout(() => {
          setActiveIndex((p) => (p < steps.length - 1 ? p + 1 : p));
        }, 120);
      }
    }
  };

  /* ---------------- TOTAL PRICE ---------------- */

  const totalPrice = useMemo(() => {
    let total = 0;

    if (safeItem.has_variants) {
      Object.values(selected.variants).forEach((v) => {
        total += Number(v.price_modifier || 0);
      });
    } else {
      total += Number(safeItem.base_price || 0);
    }

    Object.entries(selected.addons).forEach(([catId, ids]) => {
      const cat = addonCategories.find(
        (c) => String(c.id) === String(catId)
      );

      const unique = [...new Set(ids)];

      unique.forEach((id) => {
        const addon = cat?.addons.find(
          (a) => String(a.id) === String(id)
        );

        if (addon) total += Number(addon.price || 0);
      });
    });

    return total * quantity;
  }, [selected, quantity, safeItem, addonCategories]);

  /* ---------------- PAYLOAD ---------------- */

  const preparePayload = () => {
    const first = variantGroups[0];

    let payload = {
      menu_item_id: safeItem.id,
      quantity,
      variant_id: null,
      addon_ids: Object.values(selected.addons).flat(),
      order_type: orderType || "dine_in",
    };

    if (safeItem.has_variants && first) {
      payload.variant_id =
        selected.variants[first.group_id]?.id || null;
    }

    if (payload.order_type === "dine_in" && tableId) {
      payload.table_id = Number(tableId);
    }

    return payload;
  };

  const handleAddToCart = async () => {
    try {
      await dispatch(placeOrder(preparePayload())).unwrap();
      onClose();
    } catch {
      alert("Error");
    }
  };

  /* ---------------- UI ---------------- */

  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal-container" onClick={(e) => e.stopPropagation()}>

        <div className="modal-header">
          <div>
            <span>{safeItem.category_name}</span>
            <h2>{safeItem.name}</h2>
            <p>{safeItem.description}</p>
          </div>

          <img src={safeItem.image} alt="" />
          <button onClick={onClose}>×</button>
        </div>

        <div className="modal-body">
          <h3>{activeStep.group_name || activeStep.name}</h3>

          <div>
            {(activeStep.variants || activeStep.addons).map((opt) => {
              const isSelected =
                activeStep.type === "variant"
                  ? selected.variants[activeStep.group_id]?.id === opt.id
                  : (selected.addons[activeStep.id] || []).includes(
                      Number(opt.id)
                    );

              return (
                <div
                  key={opt.id}
                  onClick={() => handleSelect(activeStep, opt)}
                >
                  {opt.name} - ₹{opt.price}
                  {isSelected && " ✔"}
                </div>
              );
            })}
          </div>

          {activeIndex < steps.length - 1 && (
            <button
              onClick={() =>
                setActiveIndex((p) => (p < steps.length - 1 ? p + 1 : p))
              }
            >
              Next → {nextStep?.group_name || nextStep?.name}
            </button>
          )}
        </div>

        <div className="modal-footer">
          <button onClick={onClose}>Cancel</button>
          <button onClick={handleAddToCart}>
            Add to Cart • ₹{totalPrice.toFixed(2)}
          </button>
        </div>

        <Alert
          show={showAlert.show}
          message={showAlert.message}
          type={showAlert.type}
          onClose={() =>
            setShowAlert((p) => ({ ...p, show: false }))
          }
        />
      </div>
    </div>
  );
};

export default Modal;